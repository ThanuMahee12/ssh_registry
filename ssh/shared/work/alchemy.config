# =============================================================================
# Data Alchemy - dev box + production ny5p01-10
#
# Each server declares its IP ONCE, on a block that names the server literally
# AND as a wildcard covering that server's service-account variants:
#
#   Host alchmy_ny5p01 alchmy_ny5p01*
#        ^ literal      ^ also matches _svcP and _svcU
#
# The literal is redundant to OpenSSH - the wildcard already matches it - but
# it is REQUIRED for tooling. VS Code's Remote Explorer lists only Host entries
# with no * or ? in them; a wildcard-only block is treated as a rule, not a
# connectable target, and the server silently never appears in the sidebar.
# Same reason bench.config spells its hosts out. Verified, not folklore.
#
# The three block layers set DISJOINT keywords, so OpenSSH's first-value-wins
# never has to arbitrate between them:
#
#   alchmy_ny5p0N + N*    HostName
#   alchmy_ny5p*_svcP|U   RequestTTY + RemoteCommand
#   alchmy_ny5p*          User, ProxyJump, ForwardAgent, IdentityFile
#
# The _svcP / _svcU variants carry RemoteCommand, which HIJACKS a transfer:
# fine for interactive ssh, NOT usable as scp/rsync targets. `alc <n> P|U`
# uses them; xcp/xrsync warn and refuse. They stay wildcard-only on purpose -
# Remote-SSH could not use them as targets anyway, so listing them would only
# clutter the sidebar with entries that fail on connect.
#
# Which (server, account) pairs are actually valid is decided by the alc_svc
# map in linux/bashrc - deliberately NOT duplicated here. Every combination
# resolves at the ssh level; the server's own sudoers decides the rest.
#
# Adding a server is two lines, and the Host line carries BOTH names - drop the
# literal and the box works from the shell but vanishes from VS Code. Note the
# wildcard is alchmy_ny5p0N* with the leading zero, so ny5p10 has its own
# block and cannot collide with ny5p01.
# =============================================================================

Host alchmy_ny5p01 alchmy_ny5p01*
  HostName 10.202.210.141

Host alchmy_ny5p02 alchmy_ny5p02*
  HostName 10.202.210.162

Host alchmy_ny5p03 alchmy_ny5p03*
  HostName 10.202.210.163

Host alchmy_ny5p04 alchmy_ny5p04*
  HostName 10.202.210.164

Host alchmy_ny5p05 alchmy_ny5p05*
  HostName 10.202.210.165

Host alchmy_ny5p06 alchmy_ny5p06*
  HostName 10.202.210.166

Host alchmy_ny5p07 alchmy_ny5p07*
  HostName 10.202.210.167

Host alchmy_ny5p08 alchmy_ny5p08*
  HostName 10.202.210.168

Host alchmy_ny5p09 alchmy_ny5p09*
  HostName 10.202.210.169

Host alchmy_ny5p10 alchmy_ny5p10*
  HostName 10.202.210.170

# --- service accounts: RemoteCommand only, IP inherited from the block above -

Host alchmy_ny5p*_svcP
  RequestTTY yes
  RemoteCommand sudo su - svc_dat_alchemy

Host alchmy_ny5p*_svcU
  RequestTTY yes
  RemoteCommand sudo su - svc_dat_alche_u

# --- settings shared by every alchmy_ny5p* host ------------------------------

Host alchmy_ny5p*
  ProxyJump sf_jump
  ForwardAgent yes
  IdentityFile ~/.ssh/id_ed25519

# --- Alchemy development box (AWS; not behind sf_jump, own key) -------------

Host dev-alchmy
  HostName 172.31.37.223
  User ec2-user
  IdentityFile ~/.ssh/ec2-pair.pem
