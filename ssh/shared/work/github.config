# =============================================================================
# GitHub - WORK remotes. All route through sf_jump.
# Personal github.com lives in ../thanujan/github.config.
# =============================================================================

# github.com reached through the SF proxy
Host githubsf.com
  Hostname github.com
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  ProxyJump sf_jump
  ForwardAgent yes

Host githubsf.schonfeld.com
  Hostname github.com
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  ProxyJump sf_jump
  ForwardAgent yes

# Schonfeld's own GitHub Enterprise
Host github.schonfeld.com
  Hostname github.schonfeld.com
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  ProxyJump sf_jump
  ForwardAgent yes
