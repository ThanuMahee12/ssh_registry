# =============================================================================
# Bench servers. The `bench` helper READS AND REWRITES the HostName lines in
# this file, so each host must stay a standalone `Host` block with its own
# `HostName` line - never grouped onto a multi-host `Host` line.
# =============================================================================

Host sf_bench
  HostName 10.74.235.229
  ProxyJump sf_jump
  ForwardAgent yes
  IdentityFile ~/.ssh/id_ed25519

# Same box as sf_bench, different service account.
Host sf_bench_svc_dshare_p
  HostName 10.74.235.229
  User svc_dshare_p
  ProxyJump sf_jump
  ForwardAgent yes
  IdentityFile ~/.ssh/id_ed25519

Host bench-dev-thanush
  HostName 10.167.36.85
  User thanumahee
  IdentityFile ~/.ssh/ivedha.pem

Host bench-dev-stag
  HostName 10.43.0.90
  User bench
  IdentityFile ~/.ssh/id_ed25519

# jananthini.shuresh's bench box. Same subnet as bench-dev-thanush, so no
# ProxyJump. Logs in as the EC2 default user `bench`, not as her.
#
# Two IdentityFile lines because the right key is unconfirmed: ivedha.pem is
# what the sibling box bench-dev-thanush uses, id_ed25519 is what the other
# `User bench` box (bench-dev-stag) uses. ssh tries them in order and skips any
# that is absent on this machine. Delete the wrong one once a connection has
# actually been made.
Host bench-dev-jana
  HostName 10.167.36.198
  User bench
  IdentityFile ~/.ssh/ivedha.pem
  IdentityFile ~/.ssh/id_ed25519
