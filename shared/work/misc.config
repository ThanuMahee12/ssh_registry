# =============================================================================
# Everything else on the Schonfeld side: databricks, sandbox, data migration
# =============================================================================

Host sf_databricks_dev
  HostName 10.74.237.93
  ProxyJump sf_jump
  ForwardAgent yes
  IdentityFile ~/.ssh/id_ed25519

Host sf_databricks_prod
  HostName 10.74.237.202
  ProxyJump sf_jump
  ForwardAgent yes
  IdentityFile ~/.ssh/id_ed25519

Host SF_SANDBOX
  HostName 10.74.237.140
  User ec2-user
  ProxyJump sf_jump
  ForwardAgent yes
  IdentityFile ~/.ssh/id_ed25519

# ProxyJump by NAME (sf_jump), not the inline bthanujan.mahendran@10.202.210.201
# the Linux config used - the two are equivalent, this one stays correct if the
# jump host's IP ever moves.
Host data_migration_dev_server
  HostName ny5-dvedpadm01.dev.schonfeld.com
  ProxyJump sf_jump
  ForwardAgent yes
  IdentityFile ~/.ssh/id_ed25519

# EDP CES box. Both the alias and the bare hostname resolve, so a command
# copy-pasted from a terminal prompt (ny5-pr-edpces-03) works unchanged.
# NOTE: $HOME here is /home/<user> but reports `fuseblk` — it is cwiqfs, not
# local disk. Anything needing real POSIX locking (SQLite) must use /var/tmp.
Host edpces03 ny5-pr-edpces-03
  HostName ny5-pr-edpces-03
  ProxyJump sf_jump
  ForwardAgent yes
  IdentityFile ~/.ssh/id_ed25519
