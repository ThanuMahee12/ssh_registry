# =============================================================================
# GitLab - PERSONAL. Direct, no proxy jump.
#
# Two IdentityFile lines on purpose: this box authenticates with id_ed25519,
# the Windows PC with id_gitlab. ssh tries listed identities in order and
# silently skips ones that do not exist on this machine, so one shared block
# works on both without a per-machine override. Drop the line you retire once
# you have confirmed which key GitLab actually has.
# =============================================================================
Host gitlab.com
  Hostname gitlab.com
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentityFile ~/.ssh/id_gitlab
  IdentitiesOnly yes
